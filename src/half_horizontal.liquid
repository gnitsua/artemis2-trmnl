<style>
  .map { position: relative; width: 181px; }
  .map-body { position: absolute; left: 50%; transform: translate(-50%, -50%); z-index: 3; }
  .map-earth { position: absolute; left: 50%; top: 81%; transform: translate(-50%, -50%); z-index: 3; }
  .body-bg { background: white; padding: 0 2px; }
  .map-craft { position: absolute; transform: translate(-50%, -50%); z-index: 1; }
  .trail-dot { position: absolute; width: 1px; height: 1px; border-radius: 9999px; background: black; transform: translate(-50%, -50%); z-index: 2; }
  .circle { border-radius: 9999px; }
  .capsule-wrap {
    filter:
      drop-shadow(1px 0 0 white) drop-shadow(-1px 0 0 white)
      drop-shadow(0 1px 0 white) drop-shadow(0 -1px 0 white)
      drop-shadow(1px 1px 0 white) drop-shadow(-1px 1px 0 white)
      drop-shadow(1px -1px 0 white) drop-shadow(-1px -1px 0 white);
  }
  .capsule {
    width: 6px;
    height: 6px;
    background: black;
    clip-path: polygon(0% 0%, 100% 0%, 75% 100%, 25% 100%);
  }
</style>

<div class="layout layout--row gap--medium">
  <!-- LEFT: Map area -->
  <div class="map h--full">
    <!-- Moon -->
    <div class="map-body" style="top: {{ moon_y_pct }}%;">
      <div class="circle bg--black w--2.5 h--2.5"></div>
      <span class="label label--small body-bg" style="position: absolute; top: 100%; left: 50%; transform: translateX(-50%); white-space: nowrap;">Moon</span>
    </div>

    <!-- Trail -->
    {% for point in trail %}
      <div class="trail-dot 1bit:bg--black 2bit:bg--gray-50 4bit:bg--gray-50" style="left: {{ point.x }}%; top: {{ point.y }}%;"></div>
    {% endfor %}
    <div class="trail-dot 1bit:bg--black 2bit:bg--gray-50 4bit:bg--gray-50" style="left: {{ craft_x_pct }}%; top: {{ craft_y_pct }}%;"></div>

    <!-- Spacecraft -->
    <div class="map-craft" style="left: {{ craft_x_pct }}%; top: {{ craft_y_pct }}%;">
      <div class="capsule-wrap" style="rotate: {{ craft_heading_deg }}deg;"><div class="capsule"></div></div>
    </div>

    <!-- Earth -->
    <div class="map-earth">
      <div class="circle bg--black w--9 h--9"></div>
      <span class="label label--small body-bg" style="position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); white-space: nowrap;">Earth</span>
    </div>
  </div>

  <!-- RIGHT: Stats -->
  <div class="flex flex--col flex--center-y gap--small grow">
    <span class="title">Artemis II</span>

    <div class="flex flex--row gap--large">
      <div class="flex flex--col gap--xsmall">
        <span class="label label--small label--base">Earth</span>
        <span class="value">{{ distance_earth_km }}</span>
        <span class="label label--small">km</span>
      </div>
      <div class="flex flex--col gap--xsmall">
        <span class="label label--small label--base">Moon</span>
        <span class="value">{{ distance_moon_km }}</span>
        <span class="label label--small">km</span>
      </div>
    </div>

    <span class="label label--small label--inverted">{{ updated_at }}</span>
  </div>
</div>
