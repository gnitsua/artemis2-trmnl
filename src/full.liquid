<style>
  .map { position: relative; width: 420px; }
  .map-body { position: absolute; left: 50%; transform: translate(-50%, -50%); }
  .map-moon { z-index: 0; }
  .map-earth { bottom: 24px; left: 50%; transform: translateX(-50%); }
  .map-craft { position: absolute; transform: translate(-50%, -50%); z-index: 1; }
  .trail-dot { position: absolute; width: 3px; height: 3px; border-radius: 9999px; background: black; transform: translate(-50%, -50%); opacity: 0.2; }
  .circle { border-radius: 9999px; }
  .capsule-wrap {
    filter:
      drop-shadow(1px 0 0 white) drop-shadow(-1px 0 0 white)
      drop-shadow(0 1px 0 white) drop-shadow(0 -1px 0 white)
      drop-shadow(1px 1px 0 white) drop-shadow(-1px 1px 0 white)
      drop-shadow(1px -1px 0 white) drop-shadow(-1px -1px 0 white);
  }
  .capsule {
    width: 16px;
    height: 16px;
    background: black;
    clip-path: polygon(0% 0%, 100% 0%, 75% 100%, 25% 100%);
  }
</style>

<div class="layout layout--row gap--medium">
  <!-- LEFT: 2D trajectory map -->
  <div class="map h--full">
    <!-- Moon (dynamic y position) -->
    <div class="map-body map-moon" style="top: {{ moon_y_pct }}%;">
      <div class="circle bg--black w--8 h--8"></div>
      <span class="label label--small" style="position: absolute; top: 100%; left: 50%; transform: translateX(-50%); white-space: nowrap;">Moon</span>
    </div>

    <!-- Trail -->
    {% for point in trail %}
      <div class="trail-dot" style="left: {{ point.x }}%; top: {{ point.y }}%;"></div>
    {% endfor %}
    <div class="trail-dot" style="left: {{ craft_x_pct }}%; top: {{ craft_y_pct }}%;"></div>

    <!-- Spacecraft -->
    <div class="map-craft" style="left: {{ craft_x_pct }}%; top: {{ craft_y_pct }}%;">
      <div class="capsule-wrap" style="rotate: {{ craft_heading_deg }}deg;"><div class="capsule"></div></div>
    </div>

    <!-- Earth (fixed at bottom) -->
    <div class="map-earth" style="position: absolute;">
      <div class="circle bg--black w--16 h--16"></div>
      <span class="label label--small" style="position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); white-space: nowrap;">Earth</span>
    </div>
  </div>

  <!-- RIGHT: Mission stats -->
  <div class="flex flex--col flex--center-y gap--medium grow">
    <span class="title title--large lg:title--xxlarge">Artemis II</span>

    <div class="flex flex--col gap--small">
      <span class="label label--base lg:label--xlarge">Distance from Earth</span>
      <span class="value value--large lg:value--xxlarge">{{ distance_earth_km }}</span>
      <span class="label label--small lg:label--large">km</span>
    </div>

    <div class="divider"></div>

    <div class="flex flex--col gap--small">
      <span class="label label--base lg:label--xlarge">Distance from Moon</span>
      <span class="value value--large lg:value--xxlarge">{{ distance_moon_km }}</span>
      <span class="label label--small lg:label--large">km</span>
    </div>

    <span class="label label--small label--inverted">{{ updated_at }}</span>
  </div>
</div>
