<style>
  .map { position: relative; width: 420px; }
  .map-body { position: absolute; transform: translate(-50%, -50%); z-index: 0; }
  .map-earth { position: absolute; left: 50%; top: 81%; transform: translate(-50%, -50%); z-index: 0; }
  .map-craft { position: absolute; transform: translate(-50%, -50%); z-index: 1; }
  .trail-dot { position: absolute; width: 2px; height: 2px; border-radius: 9999px; background: black; transform: translate(-50%, -50%); }
  .circle { border-radius: 9999px; }
  .capsule-wrap {
    filter:
      drop-shadow(.5px 0 0 white) drop-shadow(-0.5px 0 0 white)
      drop-shadow(0 0.5px 0 white) drop-shadow(0 -0.5px 0 white)
      drop-shadow(0.5px 0.5px 0 white) drop-shadow(-0.5px 0.5px 0 white)
      drop-shadow(0.5px -0.5px 0 white) drop-shadow(-0.5px -0.5px 0 white);
  }
  .capsule {
    width: 7px;
    height: 7px;
    background: black;
    clip-path: polygon(0% 0%, 100% 0%, 75% 100%, 25% 100%);
  }
</style>

<div class="layout layout--row gap--medium">
  <!-- LEFT: 2D trajectory map -->
  <div class="map h--full">

    <!-- Moon (dynamic y position) -->
    <div class="map-body map-moon" style="left: {{ moon_x_pct }}%; top: {{ moon_y_pct }}%;">
      <div class="circle bg--black w--2 h--2"></div>

    </div>

    <!-- Trail -->
    {% for point in trail %}
      <div class="trail-dot 1bit:bg--black 2bit:bg--gray-50 4bit:bg--gray-50" style="left: {{ point.x }}%; top: {{ point.y }}%;"></div>
    {% endfor %}
    <div class="trail-dot 1bit:bg--black 2bit:bg--gray-50 4bit:bg--gray-50" style="left: {{ craft_x_pct }}%; top: {{ craft_y_pct }}%;"></div>

    <!-- Flyby Moon (where the moon was at closest approach) -->
    <div style="position: absolute; left: {{ flyby_moon_x_pct }}%; top: {{ flyby_moon_y_pct }}%; transform: translate(-50%, -50%); z-index: 0;">
      <div style="width: 8px; height: 8px; border-radius: 9999px; border: 1px dashed black;"></div>
    </div>
    <div class="map-craft" style="left: {{ craft_x_pct }}%; top: {{ craft_y_pct }}%;">
      <div class="capsule-wrap" style="rotate: {{ craft_heading_deg }}deg;"><div class="capsule"></div></div>
    </div>

    <!-- Earth (fixed at bottom) -->
    <div class="map-earth">
      <div class="circle bg--black w--16 h--16"></div>

    </div>
  </div>

  <!-- RIGHT: Mission stats -->
  <div class="flex flex--col flex--center-y gap--medium grow">
    <span class="title title--large lg:title--xxlarge">Artemis II</span>

    <div class="flex flex--col gap--small">
      <span class="label label--base lg:label--xlarge">Distance from Earth</span>
      <span class="value value--large lg:value--xxlarge">{{ distance_earth_km }}</span>
      <span class="label label--small lg:label--large">km</span>
    </div>

    <div class="divider"></div>

    <div class="flex flex--col gap--small">
      <span class="label label--base lg:label--xlarge">Distance from Moon</span>
      <span class="value value--large lg:value--xxlarge">{{ distance_moon_km }}</span>
      <span class="label label--small lg:label--large">km</span>
    </div>

    <span class="label label--small label--inverted">{{ updated_at }}</span>
  </div>
</div>
